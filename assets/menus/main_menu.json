{
    "name": "Main Menu",
    "background": [0.04, 0.06, 0.10, 1.0],
    "elements": [
        {
            "type": "panel",
            "x": 0.5, "y": 0.50,
            "anchor": "center",
            "width": 480, "height": 520,
            "rounding": 8,
            "color": "panel",
            "elements": [
                {
                    "type": "text",
                    "content": "FLASHBACK",
                    "font": "title",
                    "color": "text_primary",
                    "x": 0.5, "y": 60,
                    "anchor": "top_center"
                },
                {
                    "type": "text",
                    "content": "Ahamkara Engine Tech Demo",
                    "font": "small",
                    "color": "text_secondary",
                    "x": 0.5, "y": 112,
                    "anchor": "top_center"
                },
                { "type": "spacer", "height": 40 },
                {
                    "type": "button",
                    "label": "PLAY",
                    "style": "primary",
                    "action": "push_screen:map_select",
                    "x": 0.5, "y": 180,
                    "anchor": "top_center"
                },
                {
                    "type": "button",
                    "label": "SETTINGS",
                    "style": "secondary",
                    "action": "push_screen:settings",
                    "x": 0.5, "y": 240,
                    "anchor": "top_center"
                },
                {
                    "type": "button",
                    "label": "SANDBOX",
                    "style": "secondary",
                    "action": "start_sandbox",
                    "x": 0.5, "y": 300,
                    "anchor": "top_center"
                },
                { "type": "spacer", "height": 20 },
                { "type": "separator" },
                { "type": "spacer", "height": 10 },
                {
                    "type": "button",
                    "label": "QUIT TO DESKTOP",
                    "style": "secondary",
                    "action": "quit_application",
                    "x": 0.5, "y": 400,
                    "anchor": "top_center"
                },
                {
                    "type": "text",
                    "content": "Build {build_date}  |  {fps} FPS",
                    "font": "small",
                    "color": "text_secondary",
                    "x": 0.5, "y": 490,
                    "anchor": "top_center"
                }
            ]
        }
    ]
}
