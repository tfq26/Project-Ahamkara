                {
                    "type": "spinner",
                    "x": 0.5, "y": 95,
                    "anchor": "top_center",
                    "radius": 10,
                    "thickness": 2.5,
                    "color": "accent"
                }
            ]
        },
        {
            "type": "panel",
            "x": 0.5, "y": 0.08,
            "anchor": "top_center",
            "width": 300, "height": 40,
            "color": "none",
            "elements": [
                {
                    "type": "text",
                    "content": "FLASHBACK",
                    "font": "small",
                    "color": "text_secondary",
                    "x": 0.5, "y": 10,
                    "anchor": "top_center"
                }
            ]
        }
    ]
