{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with full symbols and no optimisation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with optimisations",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-headless",
      "displayName": "Debug Headless",
      "description": "Debug build for remote agents that do not need the GLFW/OpenGL client",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AHAMKARA_BUILD_CLIENT": "OFF",
        "AHAMKARA_BUILD_SAMPLES": "OFF"
      }
    },
    {
      "name": "package",
      "displayName": "Package",
      "description": "Debug configuration used to produce the distributable package",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/package"
    },
    {
      "name": "package-debug-headless",
      "displayName": "Package Debug Headless",
      "description": "Headless debug configuration used to validate server packaging",
      "inherits": "debug-headless",
      "binaryDir": "${sourceDir}/build/package-debug-headless"
    },
    {
      "name": "wish-standalone",
      "displayName": "Wish Standalone",
      "description": "Debug build of only engine core + Wish, no game/client/server/samples",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wish-standalone",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AHAMKARA_BUILD_GAME": "OFF",
        "AHAMKARA_BUILD_CLIENT": "OFF",
        "AHAMKARA_BUILD_SERVER": "OFF",
        "AHAMKARA_BUILD_SAMPLES": "OFF",
        "AHAMKARA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "engine-only-debug",
      "displayName": "Engine Only Debug",
      "description": "Pure engine SDK without game/wish/client/server — debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/engine-only-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AE_ENGINE_ONLY": "ON",
        "AHAMKARA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "engine-only-release",
      "displayName": "Engine Only Release",
      "description": "Pure engine SDK without game/wish/client/server — release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/engine-only-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AE_ENGINE_ONLY": "ON",
        "AHAMKARA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug-headless",
      "configurePreset": "debug-headless"
    },
    {
      "name": "package",
      "configurePreset": "package",
      "description": "Build for packaging (debug configuration)"
    },
    {
      "name": "package-debug-headless",
      "configurePreset": "package-debug-headless",
      "description": "Build for packaging (debug-headless configuration)"
    },
    {
      "name": "wish-standalone",
      "configurePreset": "wish-standalone"
    },
    {
      "name": "engine-only-debug",
      "configurePreset": "engine-only-debug"
    },
    {
      "name": "engine-only-release",
      "configurePreset": "engine-only-release"
    }
  ],
  "packagePresets": [
    {
      "name": "package",
      "displayName": "Package debug",
      "description": "Package the debug build into a TGZ/ZIP archive",
      "generators": ["TGZ", "ZIP"],
      "configurations": ["Debug"],
      "configurePreset": "package"
    },
    {
      "name": "package-debug-headless",
      "displayName": "Package debug-headless",
      "description": "Package the debug-headless build into a TGZ/ZIP archive",
      "generators": ["TGZ", "ZIP"],
      "configurations": ["Debug"],
      "configurePreset": "package-debug-headless"
    }
  ]
}
